---
import "@/styles/global.css";
import CommandPalette from "@/components/islands/CommandPalette";
import Terminal from "@/components/islands/Terminal";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { localePath, otherLocale, useTranslations } from "@/i18n/utils";
import { getOverlayData } from "@/lib/overlay";

interface Props {
  lang: Locale;
  title?: string;
  description?: string;
  path?: string;
}

const { lang, title, description, path = "/" } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const pageDescription = description ?? t("meta.description");
const canonical = new URL(localePath(lang, path), Astro.site);
const alternate = new URL(localePath(otherLocale(lang), path), Astro.site);
const overlay = await getOverlayData(lang, path);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLocale(lang)} href={alternate} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#047857" />
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        const dark =
          theme === "dark" ||
          (theme === null &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
        document.documentElement.classList.add("js");
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <div
      data-progress
      aria-hidden="true"
      class="from-accent to-accent-2 fixed inset-x-0 top-0 z-[55] h-0.5 origin-left scale-x-0 bg-linear-to-r"
    ></div>
    <a
      href="#main"
      class="bg-accent text-accent-fg sr-only z-50 rounded-md px-4 py-2 focus:not-sr-only focus:fixed focus:top-4 focus:left-4"
    >
      {t("nav.skip")}
    </a>
    <Header lang={lang} path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <CommandPalette client:idle data={overlay} />
    <Terminal client:idle data={overlay} />
    <script>
      import "@/scripts/effects";
    </script>
    <script>
      const targets = document.querySelectorAll(".reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      targets.forEach((target) => {
        observer.observe(target);
      });
    </script>
  </body>
</html>
