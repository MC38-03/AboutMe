---
import ContactForm from "@/components/islands/ContactForm";
import Icon from "@/components/ui/Icon.astro";
import type { IconName } from "@/lib/icons";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const socials: {
  icon: IconName;
  label: string;
  handle: string;
  href: string;
}[] = [
  {
    icon: "linkedin",
    label: "LinkedIn",
    handle: "in/muhammed-cetinkaya",
    href: site.socials.linkedin,
  },
  {
    icon: "github",
    label: "GitHub",
    handle: "@MC38-03",
    href: site.socials.github,
  },
];

const labels = {
  name: t("form.name"),
  email: t("form.email"),
  message: t("form.message"),
  honeypot: t("form.honeypot"),
  send: t("form.send"),
  sending: t("form.sending"),
  success: t("form.success"),
  error: t("form.error"),
  errName: t("form.err.name"),
  errEmail: t("form.err.email"),
  errMessage: t("form.err.message"),
};
---

<section
  aria-labelledby="contact-title"
  id="contact"
  class="relative mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6"
>
  <div
    aria-hidden="true"
    class="animate-aurora bg-accent pointer-events-none absolute top-1/3 left-1/2 -z-10 size-[30rem] -translate-x-1/2 rounded-full opacity-10 blur-[120px]"
  ></div>

  <SectionHeading
    id="contact-title"
    index="05"
    label={t("contact.label")}
    heading={t("contact.heading")}
    intro={t("contact.intro")}
  />

  <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr]">
    <div class="reveal flex flex-col gap-4">
      <div class="border-border bg-surface/70 flex items-center gap-4 rounded-2xl border p-4 backdrop-blur">
        <span class="bg-accent-soft text-accent grid size-11 shrink-0 place-items-center rounded-xl">
          <Icon name="mail" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-muted font-mono text-xs">{t("form.email")}</p>
          <a
            href={`mailto:${site.email}`}
            class="hover:text-accent block truncate font-medium"
          >
            {site.email}
          </a>
        </div>
        <button
          type="button"
          data-copy={site.email}
          data-copied-label={t("contact.copied")}
          class="border-border hover:border-accent hover:text-accent inline-flex shrink-0 items-center gap-1.5 rounded-lg border px-3 py-1.5 font-mono text-xs transition-colors"
        >
          <Icon name="copy" class="size-3.5" />
          <span>{t("contact.copy")}</span>
        </button>
      </div>

      {socials.map((social) => (
        <a
          href={social.href}
          rel="noopener"
          target="_blank"
          class="group border-border bg-surface/70 hover:border-accent/60 flex items-center gap-4 rounded-2xl border p-4 backdrop-blur transition hover:-translate-y-0.5"
        >
          <span class="bg-accent-soft text-accent grid size-11 shrink-0 place-items-center rounded-xl">
            <Icon name={social.icon} />
          </span>
          <span class="flex-1">
            <span class="text-muted block font-mono text-xs">
              {social.label}
            </span>
            <span class="font-medium">{social.handle}</span>
          </span>
          <Icon
            name="arrow"
            class="text-muted group-hover:text-accent size-5 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      ))}
    </div>

    <div class="reveal border-border bg-surface/70 relative rounded-3xl border p-6 backdrop-blur sm:p-8 [--reveal-delay:150ms]">
      <ContactForm client:visible to={site.email} labels={labels} />
    </div>
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy]")
    .forEach((button) => {
      const label = button.querySelector("span");
      const original = label?.textContent ?? "";
      button.addEventListener("click", () => {
        void navigator.clipboard
          .writeText(button.dataset.copy ?? "")
          .then(() => {
            if (!label) return;
            label.textContent = button.dataset.copiedLabel ?? original;
            setTimeout(() => {
              label.textContent = original;
            }, 1800);
          });
      });
    });
</script>
