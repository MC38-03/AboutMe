---
import ProjectCard from "@/components/ui/ProjectCard.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/utils";
import { getProjects } from "@/lib/content";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [first, ...rest] = await getProjects(lang);
---

<section
  aria-labelledby="projects-title"
  id="projects"
  class="relative mx-auto max-w-6xl scroll-mt-20 px-4 py-24 sm:px-6"
>
  <SectionHeading
    id="projects-title"
    index="02"
    label={t("projects.label")}
    heading={t("projects.heading")}
    intro={t("projects.intro")}
  />

  <div class="grid gap-5 md:grid-cols-6">
    {first && (
      <ProjectCard
        project={first}
        lang={lang}
        large
        class="md:col-span-4 md:row-span-2"
      />
    )}
    {rest.map((project) => (
      <ProjectCard project={project} lang={lang} class="md:col-span-2" />
    ))}
    <a
      href={site.socials.github}
      rel="noopener"
      target="_blank"
      class="reveal group border-border hover:border-accent/60 relative flex flex-col justify-between gap-6 overflow-hidden rounded-3xl border border-dashed p-6 transition hover:-translate-y-1 md:col-span-2"
    >
      <div
        aria-hidden="true"
        class="animate-spin-slow absolute -top-12 -right-12 size-40 rounded-full border-2 border-dashed border-current text-accent/30"
      ></div>
      <span class="bg-accent-soft text-accent grid size-12 place-items-center rounded-2xl">
        <Icon name="github" class="size-6" />
      </span>
      <span>
        <span class="text-accent font-mono text-xs">{"// todo"}</span>
        <span class="mt-2 block text-xl font-bold tracking-tight">
          {t("projects.next.title")}
        </span>
        <span class="text-muted mt-2 block text-pretty">
          {t("projects.next.text")}
        </span>
      </span>
      <span class="text-accent inline-flex items-center gap-1.5 text-sm font-medium">
        @MC38-03
        <Icon
          name="arrow"
          class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </span>
    </a>
  </div>
</section>
