---
import { iconPaths, type IconName } from "@/lib/icons";

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "size-5", strokeWidth = 2 } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={iconPaths[name]} />
</svg>
