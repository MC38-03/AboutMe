---
interface Props {
  index: string;
  label: string;
  heading: string;
  intro?: string;
  id: string;
}

const { index, label, heading, intro, id } = Astro.props;
---

<header class="reveal mb-12 max-w-2xl">
  <p class="text-accent flex items-center gap-3 font-mono text-sm">
    <span class="text-muted">{index}</span>
    <span class="bg-accent h-px w-8"></span>
    {label}
  </p>
  <h2
    id={id}
    class="mt-3 text-3xl font-bold tracking-tight text-balance sm:text-5xl"
  >
    {heading}
  </h2>
  {intro && <p class="text-muted mt-4 text-lg text-pretty">{intro}</p>}
</header>
