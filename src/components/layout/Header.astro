---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { localePath, otherLocale, useTranslations } from "@/i18n/ui";

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const other = otherLocale(lang);

const links = [
  { href: `${home}#projects`, label: t("nav.projects") },
  { href: `${home}#about`, label: t("nav.about") },
  { href: `${home}#timeline`, label: t("nav.timeline") },
  { href: `${home}#contact`, label: t("nav.contact") },
];
---

<header class="border-border bg-bg/80 sticky top-0 z-40 border-b backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href={home}
      class="flex items-center gap-2 font-semibold tracking-tight"
      aria-label={site.name}
    >
      <span class="bg-accent text-accent-fg grid size-8 place-items-center rounded-lg font-mono text-sm">
        {site.initials}
      </span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <ul class="hidden items-center gap-6 text-sm md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-muted hover:text-fg transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-1">
      <a
        href={localePath(other, path)}
        hreflang={other}
        lang={other}
        class="text-muted hover:text-fg hover:bg-surface rounded-md px-2 py-1.5 font-mono text-xs uppercase transition-colors"
        title={t("lang.switch")}
      >
        {other}
      </a>
      <ThemeToggle label={t("theme.toggle")} />
      <details class="group relative md:hidden">
        <summary
          class="text-muted hover:text-fg hover:bg-surface grid size-9 cursor-pointer list-none place-items-center rounded-md [&::-webkit-details-marker]:hidden"
          aria-label={t("nav.menu")}
        >
          <svg
            class="size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <ul class="border-border bg-surface absolute right-0 mt-2 w-48 rounded-lg border p-2 shadow-lg">
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:bg-bg block rounded-md px-3 py-2 text-sm"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll("header details a").forEach((link) => {
    link.addEventListener("click", () => {
      link.closest("details")?.removeAttribute("open");
    });
  });
</script>
