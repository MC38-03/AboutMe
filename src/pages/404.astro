---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations } from "@/i18n/utils";

const t = useTranslations("nl");
const en = useTranslations("en");
---

<BaseLayout lang="nl" title="404" path="/404" noindex>
  <section class="relative isolate mx-auto flex min-h-[70dvh] max-w-3xl flex-col items-center justify-center px-4 py-24 text-center">
    <div
      aria-hidden="true"
      class="animate-aurora bg-accent pointer-events-none absolute top-1/4 left-1/2 -z-10 size-[28rem] -translate-x-1/2 rounded-full opacity-15 blur-[120px]"
    ></div>
    <p class="text-accent font-mono text-sm">$ cd ./deze-pagina</p>
    <p class="text-muted mt-1 font-mono text-sm">
      bash: cd: no such file or directory
    </p>
    <h1 class="from-accent to-accent-2 mt-6 bg-linear-to-r bg-clip-text text-8xl font-bold tracking-tighter text-transparent sm:text-9xl">
      404
    </h1>
    <h2 class="mt-4 text-2xl font-bold tracking-tight">
      {t("notFound.title")}
    </h2>
    <p class="text-muted mt-3 max-w-md text-pretty">{t("notFound.text")}</p>
    <p class="text-muted mt-1 max-w-md text-sm text-pretty" lang="en">
      {en("notFound.text")}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        data-magnetic
        class="bg-accent text-accent-fg rounded-full px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5"
      >
        {t("notFound.home")}
      </a>
      <button
        type="button"
        data-open="palette"
        class="border-border hover:border-accent rounded-full border px-6 py-3 font-mono text-sm transition"
      >
        <span data-shortcut>⌘K</span>
      </button>
    </div>
  </section>
</BaseLayout>
