---
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/ui";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-border border-t">
  <div class="text-muted mx-auto flex max-w-5xl flex-col gap-3 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>
      © {year} {site.name}. {t("footer.built")}
    </p>
    <ul class="flex gap-4">
      <li>
        <a href={site.socials.github} class="hover:text-fg">
          GitHub
        </a>
      </li>
      <li>
        <a href={site.socials.linkedin} class="hover:text-fg">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.sourceUrl} class="hover:text-fg">
          {t("footer.source")}
        </a>
      </li>
    </ul>
  </div>
</footer>
