---
import Icon from "@/components/ui/Icon.astro";
import { site } from "@/data/site";
import type { Locale } from "@/i18n/locales";
import { useTranslations } from "@/i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-border relative overflow-hidden border-t">
  <div
    aria-hidden="true"
    class="from-accent/60 via-accent-2/60 absolute inset-x-0 top-0 h-px bg-linear-to-r to-transparent"
  ></div>
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="flex items-center gap-3">
      <span class="bg-accent text-accent-fg grid size-9 place-items-center rounded-lg font-mono text-sm font-semibold">
        {site.initials}
      </span>
      <div class="text-sm">
        <p class="font-medium">
          © {year} {site.name}
        </p>
        <p class="text-muted">{t("footer.built")}</p>
        <button
          type="button"
          data-open="terminal"
          class="text-muted hover:text-accent mt-1 hidden font-mono text-xs transition-colors md:block"
        >
          {t("footer.terminal")}
        </button>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <a
        href={site.socials.github}
        class="text-muted hover:text-fg hover:bg-surface grid size-9 place-items-center rounded-lg transition-colors"
        aria-label="GitHub"
      >
        <Icon name="github" />
      </a>
      <a
        href={site.socials.linkedin}
        class="text-muted hover:text-fg hover:bg-surface grid size-9 place-items-center rounded-lg transition-colors"
        aria-label="LinkedIn"
      >
        <Icon name="linkedin" />
      </a>
      <a
        href={site.sourceUrl}
        class="border-border text-muted hover:text-fg hover:border-accent inline-flex items-center gap-2 rounded-lg border px-3 py-1.5 font-mono text-xs transition-colors"
      >
        <Icon name="code" class="size-4" />
        {t("footer.source")}
      </a>
      <a
        href="#main"
        class="text-muted hover:text-fg hover:bg-surface grid size-9 place-items-center rounded-lg transition-colors"
        aria-label={t("footer.top")}
        title={t("footer.top")}
      >
        <Icon name="arrow" class="size-4 -rotate-45" />
      </a>
    </div>
  </div>
</footer>
